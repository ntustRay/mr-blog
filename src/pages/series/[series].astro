---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seriesDefinitions } from '../../config/series';
import projects from '../../data/projects.json';
import { getSeriesPosts } from '../../utils/series';
import { getSeriesPreview } from '../../utils/series-preview';
import { projectForSeries } from '../../utils/project-seo';
import { formatDate } from '../../utils/date';
import CategoryLink from '../../components/CategoryLink.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return seriesDefinitions.map((series) => ({
    params: { series: series.id },
    props: {
      series,
      posts: getSeriesPosts(series.id, posts),
    },
  }));
}
interface Props {
  series: (typeof seriesDefinitions)[number];
  posts: CollectionEntry<'blog'>[];
}
const { series, posts } = Astro.props;
const project = projects.find(item => item.seriesId === series.id);
const intro = 'intro' in series ? series.intro : null;
const notice = 'notice' in series ? series.notice : null;
const chapters = 'chapters' in series ? series.chapters : [];
const resources = 'resources' in series ? series.resources : [];
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const preview = getSeriesPreview(series, base, project);
const siteUrl = new URL(base, Astro.site ?? Astro.url.origin);
const about = projectForSeries(series.id, siteUrl);
const pageUrl = new URL(`series/${series.id}/`, siteUrl).href;
const structuredData = about && {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl,
  name: series.title,
  description: series.description,
  url: pageUrl,
  about,
  isPartOf: { '@id': `${siteUrl.href}#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: new URL(`posts/${post.id}/`, siteUrl).href,
    })),
  },
};
const toHref = (href: string) => /^https?:\/\//u.test(href) ? href : `${base}${href}`;
const getChapterLabel = (index: number) => chapters[index] ?? (project
  ? index === 0 ? '專案介紹' : index === posts.length - 1 ? '總結與取捨' : '實作教學'
  : null);
---

<BaseLayout title={series.title} description={series.description} structuredData={structuredData}
  ogImage={new URL(preview.src, siteUrl).href} ogImageDetails={preview}>
  <section class:list={['page-header', { 'course-header': !intro }]}>
    <div>
      <p class="eyebrow">SERIES · {posts.length} PARTS</p>
      <h1>{series.title}</h1>
      <p>{series.description}</p>
      {project && <p><a href={`${base}projects/${project.id}/`}>專案介紹與入口 →</a></p>}
    </div>
    {!intro && <img class="course-preview" src={preview.src} alt={preview.alt}
      width={preview.width} height={preview.height} decoding="async" />}
  </section>
  {intro && (
    <section class="series-guide" aria-labelledby="series-guide-heading">
      <div class="series-guide__copy">
        <h2 id="series-guide-heading">閱讀指南</h2>
        <p>{intro}</p>
        {notice && <p class="series-guide__notice">{notice}</p>}
        {resources.length > 0 && (
          <nav class="series-guide__resources" aria-label="系列資源">
            {resources.map((resource) => (
              <a href={toHref(resource.href)}>{resource.label} →</a>
            ))}
          </nav>
        )}
      </div>
      <figure class="series-guide__preview">
        <img src={preview.src} alt={preview.alt} width={preview.width} height={preview.height}
          loading="lazy" decoding="async" />
        {'previewImage' in series && <figcaption>{series.previewImage.caption}</figcaption>}
      </figure>
    </section>
  )}
  <h2 class="series-contents-heading">依順序閱讀</h2>
  <ol class="series-post-list">
    {posts.map((post, index) => (
      <li>
        <span class="series-index">{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
        <div>
          {getChapterLabel(index) && <span class="series-stage">{getChapterLabel(index)}</span>}
          <div class="post-meta">
            <CategoryLink category={post.data.category} />
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .course-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 36%);
    align-items: center;
    gap: 24px;
  }
  .course-preview {
    display: block;
    width: 100%;
    height: auto;
    max-height: 250px;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }
  @media (max-width: 620px) {
    .course-header { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
