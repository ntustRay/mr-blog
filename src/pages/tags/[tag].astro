---
import { getCollection, type CollectionEntry } from 'astro:content';
import CategoryLink from '../../components/CategoryLink.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { getTagSlug } from '../../utils/tags';

interface TagGroup {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const groups = new Map<string, TagGroup>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = getTagSlug(tag);
      const existing = groups.get(slug);

      if (existing && existing.tag !== tag) {
        throw new Error(
          `Tags "${existing.tag}" and "${tag}" produce the same slug "${slug}".`,
        );
      }

      if (existing) {
        existing.posts.push(post);
      } else {
        groups.set(slug, { tag, posts: [post] });
      }
    }
  }

  return [...groups.entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: {
      tag: group.tag,
      posts: [...group.posts].sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      ),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
const tagSummaries: Record<string, string> = {
  'AI Agents': 'AI Agent 的工具使用、Harness、Context Management 與安全性相關文章。',
  TypeScript: 'TypeScript 的型別設計、工具鏈與應用實作文章。',
  DuckDB: 'DuckDB、資料處理和整合應用的相關文章。',
  Canvas: 'Canvas Rendering、繪圖與效能議題的相關文章。',
  Bun: 'Bun 的套件管理、工具鏈與導入成本的相關文章。',
};
const summary = tagSummaries[tag] ?? `整理與 ${tag} 相關的技術文章與筆記。`;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`#${tag}`}
  description={summary}
>
  <section class="page-header">
    <p class="eyebrow">TAG</p>
    <h1>#{tag}</h1>
    <p>{summary}</p>
    <p>{posts.length} 篇文章</p>
  </section>

  <div class="post-list">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">
          <CategoryLink category={post.data.category} />
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <TagList tags={post.data.tags} />
        </div>

        <h3>
          <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
        </h3>

        <p>{post.data.description}</p>

        <a class="read-more" href={`${base}posts/${post.id}/`}>
          閱讀文章 →
        </a>
      </article>
    ))}
  </div>
</BaseLayout>
