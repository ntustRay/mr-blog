---
import { getCollection } from 'astro:content';
import CategoryLink from '../components/CategoryLink.astro';
import TagList from '../components/TagList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../utils/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="MR Blog"
  description="記錄技術、開發實作與持續學習。"
>
  <section class="hero">
    <p class="eyebrow">MINGRAY'S NOTES</p>
    <h1>MR Blog</h1>
    <p class="hero-description">
      記錄技術、開發實作與持續學習。
    </p>
  </section>

  <section aria-labelledby="posts-heading">
    <div class="section-heading">
      <h2 id="posts-heading">最新文章</h2>
      <span>{posts.length} 篇</span>
    </div>

    <div class="post-list">
      {posts.map((post) => (
        <article class="post-card">
          <div class="post-meta">
            <CategoryLink category={post.data.category} />
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <TagList tags={post.data.tags} />
          </div>

          <h3>
            <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
          </h3>

          <p>{post.data.description}</p>

          <a class="read-more" href={`${base}posts/${post.id}/`}>
            閱讀文章 →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
