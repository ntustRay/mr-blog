---
import { getCollection, type CollectionEntry } from 'astro:content';
import CategoryLink from '../../components/CategoryLink.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategorySlug } from '../../utils/categories';
import { formatDate } from '../../utils/date';

interface CategoryGroup {
  category: string;
  posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const groups = new Map<string, CategoryGroup>();

  for (const post of posts) {
    const { category } = post.data;
    const slug = getCategorySlug(category);
    const existing = groups.get(slug);

    if (existing && existing.category !== category) {
      throw new Error(
        `Categories "${existing.category}" and "${category}" produce the same slug "${slug}".`,
      );
    }

    if (existing) {
      existing.posts.push(post);
    } else {
      groups.set(slug, { category, posts: [post] });
    }
  }

  return [...groups.entries()].map(([slug, group]) => ({
    params: { category: slug },
    props: {
      category: group.category,
      posts: [...group.posts].sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      ),
    },
  }));
}

interface Props {
  category: string;
  posts: CollectionEntry<'blog'>[];
}

const { category, posts } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={category}
  description={`${category} 分類的文章，共 ${posts.length} 篇。`}
>
  <section class="page-header">
    <p class="eyebrow">CATEGORY</p>
    <h1>{category}</h1>
    <p>{posts.length} 篇文章</p>
  </section>

  <div class="post-list">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">
          <CategoryLink category={post.data.category} />
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <TagList tags={post.data.tags} />
        </div>

        <h3>
          <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
        </h3>

        <p>{post.data.description}</p>

        <a class="read-more" href={`${base}posts/${post.id}/`}>
          閱讀文章 →
        </a>
      </article>
    ))}
  </div>
</BaseLayout>
