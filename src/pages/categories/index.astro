---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../config/taxonomy';
import { getCategorySlug } from '../../utils/categories';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const populated = categories.map((category) => ({
  ...category,
  count: posts.filter((post) => post.data.category === category.name).length,
}));
const primary = populated.filter((category) => category.primary);
const additional = populated.filter((category) => !category.primary);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Topics" description="依技術領域瀏覽 MR Blog 全部文章。">
  <section class="page-header">
    <p class="eyebrow">TOPICS</p>
    <h1>Topics</h1>
    <p>依問題領域瀏覽文章；技術細節則使用 Tags。</p>
  </section>

  <section class="home-section" aria-labelledby="core-topics">
    <div class="section-heading"><h2 id="core-topics">Core Topics</h2></div>
    <div class="topic-grid">
      {primary.map((category) => (
        <a class="topic-card" href={`${base}categories/${getCategorySlug(category.name)}/`}>
          <strong>{category.name}</strong>
          <span>{category.description}</span>
          <small>{category.count} posts</small>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="more-topics">
    <div class="section-heading"><h2 id="more-topics">More Topics</h2></div>
    <div class="topic-grid">
      {additional.map((category) => (
        <a class="topic-card" href={`${base}categories/${getCategorySlug(category.name)}/`}>
          <strong>{category.name}</strong>
          <span>{category.description}</span>
          <small>{category.count} posts</small>
        </a>
      ))}
    </div>
  </section>
  <p class="browse-tags"><a href={`${base}tags/`}>Browse all tags →</a></p>
</BaseLayout>
