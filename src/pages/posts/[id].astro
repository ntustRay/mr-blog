---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CategoryLink from '../../components/CategoryLink.astro';
import CodeCopyEnhancer from '../../components/CodeCopyEnhancer.astro';
import CopyLink from '../../components/CopyLink.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import References from '../../components/References.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TagList from '../../components/TagList.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategorySlug } from '../../utils/categories';
import { formatDate } from '../../utils/date';
import { getRelatedPosts } from '../../utils/relatedPosts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) =>
      a.data.pubDate.valueOf() - b.data.pubDate.valueOf() ||
      a.id.localeCompare(b.id),
  );

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previousPost: posts[index - 1] ?? null,
      nextPost: posts[index + 1] ?? null,
      relatedPosts: getRelatedPosts(post, posts),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  previousPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, previousPost, nextPost, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
const ogImage = post.data.coverImage ?? `og/${post.id}.webp`;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const articleURL = new URL(
  `${base}posts/${post.id}/`,
  Astro.site ?? Astro.url.origin,
);
const imageURL = /^https?:\/\//u.test(ogImage)
  ? new URL(ogImage)
  : new URL(
      `${base}${ogImage.replace(/^\/+/, '')}`,
      Astro.site ?? Astro.url.origin,
    );
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  image: imageURL.href,
  url: articleURL.href,
  mainEntityOfPage: articleURL.href,
  articleSection: post.data.category,
  inLanguage: siteConfig.locale,
  author: {
    '@type': 'Person',
    name: siteConfig.author.name,
    url: siteConfig.author.url,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  structuredData={structuredData}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  wide
>
  <article class="article">
    <div class="article-main" data-pagefind-body>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={base}>Posts</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}categories/${getCategorySlug(post.data.category)}/`}>
          {post.data.category}
        </a>
      </nav>

      <header class="article-header">
        <div class="post-meta">
          <CategoryLink category={post.data.category} />
          <span>
            Published <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </span>
          {post.data.updatedDate && (
            <span>
              Updated <time datetime={post.data.updatedDate.toISOString()}>
                {formatDate(post.data.updatedDate)}
              </time>
            </span>
          )}
          <TagList tags={post.data.tags} />
        </div>

        <h1>{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <CopyLink />
      </header>

      <TableOfContents headings={headings} collapsible />

      <div class="prose">
        <Content />
      </div>

      <CodeCopyEnhancer />
      <References references={post.data.references} />
      <RelatedPosts posts={relatedPosts} />

      <PostNavigation
        previousPost={previousPost}
        nextPost={nextPost}
      />
    </div>

    <aside class="article-sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </article>
</BaseLayout>
