---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostNavigation from '../../components/PostNavigation.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) =>
      a.data.pubDate.valueOf() - b.data.pubDate.valueOf() ||
      a.id.localeCompare(b.id),
  );

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previousPost: posts[index - 1] ?? null,
      nextPost: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  previousPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const ogImage = post.data.coverImage ?? `og/${post.id}.webp`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
>
  <article class="article" data-pagefind-body>
    <header class="article-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-TW')}
        </time>
        <TagList tags={post.data.tags} />
      </div>

      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    <PostNavigation
      previousPost={previousPost}
      nextPost={nextPost}
    />
  </article>
</BaseLayout>
