---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CategoryLink from '../../components/CategoryLink.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyLink from '../../components/CopyLink.astro';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) =>
      a.data.pubDate.valueOf() - b.data.pubDate.valueOf() ||
      a.id.localeCompare(b.id),
  );

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previousPost: posts[index - 1] ?? null,
      nextPost: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  previousPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const ogImage = post.data.coverImage ?? `og/${post.id}.webp`;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const articleURL = new URL(
  `${base}posts/${post.id}/`,
  Astro.site ?? Astro.url.origin,
);
const imageURL = /^https?:\/\//u.test(ogImage)
  ? new URL(ogImage)
  : new URL(`${base}${ogImage.replace(/^\/+/, '')}`, Astro.site ?? Astro.url.origin);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  image: imageURL.href,
  url: articleURL.href,
  mainEntityOfPage: articleURL.href,
  articleSection: post.data.category,
  inLanguage: 'zh-Hant',
  author: {
    '@type': 'Person',
    name: 'MingRay',
    url: 'https://github.com/ntustRay',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  structuredData={structuredData}
>
  <article class="article" data-pagefind-body>
    <header class="article-header">
      <div class="post-meta">
        <CategoryLink category={post.data.category} />
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <TagList tags={post.data.tags} />
      </div>

      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <CopyLink />
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    <PostNavigation
      previousPost={previousPost}
      nextPost={nextPost}
    />
  </article>
</BaseLayout>
