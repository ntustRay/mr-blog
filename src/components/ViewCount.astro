---
import { getPageViewCount, getViewSnapshot } from '../utils/viewCounts.mjs';

type Props =
  | { scope: 'site' | 'page'; label?: string }
  | { scope: 'post'; count: number | null; label?: never };

const props = Astro.props;
const { scope } = props;
const compact = scope === 'post';
const labels = { site: '全站瀏覽量', page: '本頁瀏覽量', post: '文章瀏覽量' };
const label = props.label ?? labels[scope];
const snapshot = getViewSnapshot(import.meta.env.BASE_URL);

let count: number | null;
if (props.scope === 'post') {
  count = props.count;
} else if (props.scope === 'site') {
  count = snapshot?.totalViews ?? null;
} else {
  count = getPageViewCount(snapshot, Astro.url.pathname);
}

const value = count?.toLocaleString('zh-TW') ?? (compact ? '—' : '暫無資料');
const updated = snapshot && new Intl.DateTimeFormat('zh-TW', {
  dateStyle: 'medium',
  timeZone: 'Asia/Taipei',
}).format(new Date(snapshot.updatedAt));
---

<span
  class:list={['view-count', { 'view-count--compact': compact }]}
  data-pagefind-ignore
  data-view-count={scope}
  title={updated ? `GA4 累計瀏覽次數 · 更新於 ${updated}` : 'GA4 瀏覽量暫無資料'}
>
  <svg width={compact ? 14 : 16} height={compact ? 14 : 16} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
    <circle cx="12" cy="12" r="3" />
  </svg>
  <span>
    <span class="view-count-label">{label}{' '}</span><span class="view-count-value">{value}</span>
  </span>
</span>

<style>
  .view-count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--subtle);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .view-count--compact {
    gap: 4px;
    border-left: 1px solid var(--line);
    padding-left: .55rem;
    font-size: inherit;
  }

  .view-count--compact .view-count-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .view-count-value {
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
</style>
