---
import { getTagSlug, normalizeTag } from '../utils/tags';

interface Props {
  tags: string[];
  limit?: number;
}

const { tags, limit } = Astro.props;
const visibleTags = [...new Set(tags.map(normalizeTag))].slice(0, limit ?? tags.length);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

{visibleTags.length > 0 && (
  <span class="tag-list">
    {visibleTags.map((tag) => (
      <a class="tag" href={`${base}tags/${getTagSlug(tag)}/`}>
        {tag}
      </a>
    ))}
  </span>
)}
