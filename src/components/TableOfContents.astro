---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  collapsible?: boolean;
}

const { headings, collapsible = false } = Astro.props;
const visibleHeadings = headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
---

{visibleHeadings.length > 1 && (
  collapsible ? (
    <details class="toc toc--mobile" data-pagefind-ignore>
      <summary class="toc-title">文章目錄</summary>
      <ol>
        {visibleHeadings.map((heading) => (
          <li class:list={{ 'toc-item--nested': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <nav class="toc toc--desktop" aria-label="文章目錄">
      <p class="toc-title">文章目錄</p>
      <ol>
        {visibleHeadings.map((heading) => (
          <li class:list={{ 'toc-item--nested': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
)}

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.toc--mobile');
  menu?.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('a[href^="#"]')) {
      menu.open = false;
    }
  });
</script>
