---
import { siteConfig } from '../config/site';

const { label, url } = siteConfig.peer;
---

<a class="edition-link" href={url} aria-label={`切換至 MR ${label}`}>
  {label}
  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 8h15m-4-4 4 4-4 4M20 16H5m4-4-4 4 4 4" />
  </svg>
</a>

<style>
  .edition-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--text);
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .edition-link:hover { color: var(--link); }
</style>
