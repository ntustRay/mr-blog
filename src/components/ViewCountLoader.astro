---
// Load once per page, only on the published site. Local previews and CI must
// not contribute to the public counters.
const canonicalOrigin = Astro.site?.origin;
const basePath = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/`;
---

<script is:inline define:vars={{ canonicalOrigin, basePath, enabled: import.meta.env.PROD }}>
  if (
    enabled &&
    window.location.origin === canonicalOrigin &&
    window.location.pathname.startsWith(basePath)
  ) {
    const script = document.createElement('script');
    script.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
    script.async = true;
    document.head.appendChild(script);
  }
</script>
