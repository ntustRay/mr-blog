---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import BlogSwitcher from '../components/BlogSwitcher.astro';
import ViewCount from '../components/ViewCount.astro';
import GiscusSession from '../components/GiscusSession.astro';
import { commentsConfig } from '../config/comments';

interface Props {
  title: string;
  description: string;
  searchAssets?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  seoTitle?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  wide?: boolean;
}

const {
  title,
  description,
  searchAssets = false,
  ogImage = 'og-default.webp',
  ogType = 'website',
  structuredData,
  seoTitle,
  noindex = false,
  publishedTime,
  modifiedTime,
  wide = false,
} = Astro.props;

const siteName = siteConfig.name;
const displayedTitle = seoTitle ?? title;
const pageTitle = displayedTitle === siteName ? siteName : `${displayedTitle} | ${siteName}`;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteURL = new URL(base, Astro.site ?? Astro.url.origin);
const authorURL = new URL(siteConfig.author.profilePath, siteURL);
const relativePath =
  base === '/'
    ? Astro.url.pathname
    : Astro.url.pathname.startsWith(base)
      ? `/${Astro.url.pathname.slice(base.length)}`
      : Astro.url.pathname;
const ogImageURL = /^https?:\/\//u.test(ogImage)
  ? new URL(ogImage)
  : new URL(
      `${base}${ogImage.replace(/^\/+/, '')}`,
      Astro.site ?? Astro.url.origin,
    );
const adsenseClient = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

if (adsenseClient && !/^ca-pub-\d+$/u.test(adsenseClient)) {
  throw new Error(
    'PUBLIC_GOOGLE_ADSENSE_CLIENT must use the ca-pub-<digits> format.',
  );
}

const navigation = [
  { label: 'Posts', href: base, active: relativePath === '/' || relativePath.startsWith('/posts/') },
  { label: 'Topics', href: `${base}categories/`, active: relativePath.startsWith('/categories/') || relativePath.startsWith('/tags/') },
  { label: 'Series', href: `${base}series/`, active: relativePath.startsWith('/series/') },
  { label: 'Projects', href: `${base}projects/`, active: relativePath.startsWith('/projects/') },
  { label: 'Archive', href: `${base}archive/`, active: relativePath.startsWith('/archive/') },
] as const;

const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL.href}#website`,
  name: siteConfig.name,
  description: siteConfig.description,
  url: siteURL.href,
  inLanguage: siteConfig.locale,
  publisher: { '@id': `${authorURL.href}#person` },
};
const authorStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${authorURL.href}#person`,
  name: siteConfig.author.name,
  jobTitle: siteConfig.author.role,
  url: authorURL.href,
  sameAs: [siteConfig.author.url],
};
const additionalStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const serializedStructuredData = JSON.stringify([
  websiteStructuredData,
  authorStructuredData,
  ...additionalStructuredData,
]).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#191A19" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {ogType === 'article' && commentsConfig.enabled && commentsConfig.categoryId && <GiscusSession />}

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon-light.svg`} media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={`${base}rss.xml`}
    />

    {searchAssets && (
      <>
        <link
          rel="stylesheet"
          href={`${base}pagefind/pagefind-component-ui.css`}
        />
        <script
          is:inline
          type="module"
          src={`${base}pagefind/pagefind-component-ui.js`}
        ></script>
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.openGraphLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogType === 'article' && <meta name="giscus:backlink" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script
      is:inline
      type="application/ld+json"
      set:html={serializedStructuredData}
    ></script>

    {adsenseClient && (
      <script
        is:inline
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      ></script>
    )}

    <title>{pageTitle}</title>
    {import.meta.env.PROD && (
      <script is:inline>
        (() => {
          const page = document.querySelector('link[rel="canonical"]');
          const base = '/mr-blog/';
          if (!page || location.origin !== 'https://ntustray.github.io' ||
              !location.pathname.startsWith(base) || navigator.doNotTrack === '1' ||
              navigator.globalPrivacyControl || window['ga-disable-G-2YEXBE8Q9Z']) return;

          // GA can attach the original URL to automatic events.
          const referrer = document.referrer ? new URL(document.referrer) : null;
          if (location.search || location.hash || referrer?.search || referrer?.hash) return;

          const canonical = new URL(page.href);
          if (canonical.origin !== location.origin || canonical.pathname !== location.pathname) return;
          const measurementId = 'G-2YEXBE8Q9Z';
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', measurementId, {
            page_location: canonical.origin + canonical.pathname,
            page_referrer: referrer?.origin ?? '',
            page_title: document.title,
            cookie_path: base,
            cookie_prefix: 'mr_blog',
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
          });
          const tag = document.createElement('script');
          tag.async = true;
          tag.referrerPolicy = 'no-referrer';
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.append(tag);
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="masthead">
      <div class="container mast-inner">
        <a class="wordmark" href={base} aria-label={`${siteName} 首頁`}>
          <img src={`${base}brand-mark.svg`} width="26" height="26" alt="" />
          <span>{siteName}</span>
        </a>
        <a class="identity" href={authorURL}>
          MingRay Hsu<span>{siteConfig.byline}</span>
        </a>
        <nav class="desktop-nav" aria-label="主要導覽">
          {navigation.map(({ label, href, active }) => (
            <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="mast-tools">
          <a class="mast-search" href={`${base}search/`} aria-label="搜尋文章" aria-keyshortcuts="/">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" />
            </svg>
            <span>Search</span><kbd>/</kbd>
          </a>
          <div class="desktop-switch"><BlogSwitcher /></div>
          <details class="mobile-menu">
            <summary aria-label="主要選單">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <nav aria-label="手機導覽">
              {navigation.map(({ label, href, active }) => (
                <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>
              ))}
              <a href={authorURL}>About</a>
              <BlogSwitcher />
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main-content" class:list={['container', { 'container--wide': wide }]}>
      <slot />
    </main>

    <footer class="mast-footer">
      <div class="container foot-inner">
        <a class="foot-brand" href={base}>
          <img src={`${base}brand-mark.svg`} width="21" height="21" alt="" />
          {siteName}
        </a>
        <div class="foot-meta">
          <small>© {new Date().getFullYear()} MingRay Hsu</small>
          {ogType !== 'article' && (
            <ViewCount scope="page" label={relativePath === '/' ? '首頁瀏覽量' : '此頁瀏覽量'} />
          )}
        </div>
        <nav aria-label="頁尾導覽">
          <a href={authorURL}>About</a>
          <a href={`${base}series/`}>Series</a>
          <a href={`${base}privacy/`}>Privacy</a>
          <a href={`${base}contact/`}>Contact</a>
          <a href={`${base}rss.xml`}>RSS</a>
          <a href={siteConfig.author.url} target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
    if (event.key !== '/' || event.ctrlKey || event.altKey || event.metaKey || event.defaultPrevented) return;
    const editing = event.composedPath().some((element) =>
      element instanceof HTMLElement && (element.isContentEditable || element.matches('input, textarea, select, [role="textbox"]'))
    );
    const searchLink = document.querySelector<HTMLAnchorElement>('.mast-search');
    if (editing || !searchLink) return;
    event.preventDefault();
    if (searchLink.pathname === location.pathname) {
      document.querySelector<HTMLElement>('pagefind-input')?.focus();
    } else {
      location.assign(searchLink.href);
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>

<style>
  .skip-link { position: absolute; top: 6px; left: var(--gutter); z-index: 20; padding: 8px 15px; transform: translateY(-150%); background: var(--accent); color: var(--canvas); }
  .skip-link:focus { transform: none; }
  .masthead { position: relative; z-index: 5; border-bottom: 1px solid var(--line); background: var(--canvas); }
  .mast-inner { min-height: 76px; display: flex; align-items: center; gap: 21px; }
  .masthead a, .mast-footer a { text-decoration: none; }
  .wordmark, .foot-brand { display: inline-flex; align-items: center; gap: 11px; white-space: nowrap; color: var(--text-strong); font-weight: 750; }
  .wordmark { font-size: 26px; letter-spacing: -.055em; line-height: 1; }
  .wordmark img, .foot-brand img { display: block; flex: none; }
  .identity { border-left: 1px solid var(--line); padding-left: 18px; color: var(--text); font-size: 13px; font-weight: 600; line-height: 1.42; letter-spacing: .01em; white-space: nowrap; }
  .identity span { display: block; color: var(--muted); font-size: 11px; font-weight: 400; }
  .desktop-nav { display: flex; align-self: stretch; gap: clamp(14px, 2vw, 31px); margin-left: auto; }
  .desktop-nav a { display: inline-flex; align-items: center; position: relative; font-size: 14px; font-weight: 550; color: var(--muted); }
  .desktop-nav a:is(:hover, [aria-current]), .mobile-menu a[aria-current], .identity:hover { color: var(--accent); }
  .desktop-nav a[aria-current]::after { position: absolute; bottom: 13px; left: 0; right: 0; width: 15px; height: 2px; margin: auto; background: var(--accent); content: ''; }
  .mast-tools { display: flex; align-items: center; gap: 18px; margin-left: clamp(1px, 1.65vw, 23px); }
  .mast-tools svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .mast-search { display: inline-flex; align-items: center; gap: 8px; min-height: 35px; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; color: var(--text); font-size: 13px; }
  .mast-search:hover { border-color: var(--muted); }
  .mast-search kbd { border: 1px solid var(--line); border-radius: 3px; padding: 1px 4px; color: var(--muted); font: 11px/1.12 var(--font-mono); }
  .mobile-menu { display: none; }
  .mast-footer { padding: 28px 0; border-top: 1px solid var(--line); color: var(--muted); }
  .foot-inner, .foot-meta, .mast-footer nav { display: flex; align-items: center; flex-wrap: wrap; }
  .foot-inner { gap: 12px 25px; }
  .foot-brand { font-size: 1rem; letter-spacing: -.04em; }
  .foot-meta { gap: 10px 16px; }
  .mast-footer nav { gap: 7px 16px; margin-left: auto; font-size: .8125rem; }
  .mast-footer a:hover { color: var(--link); }
  @media (max-width: 1050px) {
    .identity { display: none; }
  }
  @media (max-width: 820px) {
    .mast-inner { min-height: 62px; gap: 10px; }
    .wordmark { font-size: 23px; }
    .desktop-nav, .desktop-switch { display: none; }
    .mast-tools { margin-left: auto; gap: 4px; }
    .mast-search, .mobile-menu summary { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; color: var(--text); cursor: pointer; }
    .mast-search svg { width: 20px; height: 20px; }
    .mast-search span, .mast-search kbd { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary { list-style: none; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; display: grid; padding: 4px var(--gutter) 9px; border-block: 1px solid var(--line); background: var(--surface); box-shadow: 0 12px 18px #0004; }
    .mobile-menu nav > :global(a) { border-bottom: 1px solid var(--line); display: flex; align-items: center; min-height: 44px; font-size: 14px; }
    .mobile-menu nav > :global(a:last-child) { border-bottom: 0; }
  }
  @media (max-width: 640px) {
    .mast-footer nav { flex-basis: 100%; margin: 0; }
  }
</style>
