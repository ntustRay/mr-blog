---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  searchAssets?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  searchAssets = false,
  ogImage = 'og-default.webp',
  ogType = 'website',
  structuredData,
} = Astro.props;

const siteName = siteConfig.name;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const ogImageURL = /^https?:\/\//u.test(ogImage)
  ? new URL(ogImage)
  : new URL(
      `${base}${ogImage.replace(/^\/+/, '')}`,
      Astro.site ?? Astro.url.origin,
    );
const adsenseClient = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT;

if (adsenseClient && !/^ca-pub-\d+$/u.test(adsenseClient)) {
  throw new Error(
    'PUBLIC_GOOGLE_ADSENSE_CLIENT must use the ca-pub-<digits> format.',
  );
}

const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.description,
  url: new URL(base, Astro.site ?? Astro.url.origin).href,
  inLanguage: siteConfig.locale,
};
const serializedStructuredData = JSON.stringify(
  structuredData
    ? [websiteStructuredData, structuredData]
    : websiteStructuredData,
).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111827" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={`${base}rss.xml`}
    />

    {searchAssets && (
      <>
        <link
          rel="stylesheet"
          href={`${base}pagefind/pagefind-component-ui.css`}
        />
        <script
          is:inline
          type="module"
          src={`${base}pagefind/pagefind-component-ui.js`}
        ></script>
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script
      is:inline
      type="application/ld+json"
      set:html={serializedStructuredData}
    ></script>

    {adsenseClient && (
      <script
        is:inline
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      ></script>
    )}

    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>{siteConfig.name}</a>
        <nav aria-label="Main navigation">
          <a href={base}>Posts</a>
          <a href={`${base}categories/`}>Categories</a>
          <a href={`${base}tags/`}>Tags</a>
          <a href={`${base}archive/`}>Archive</a>
          <a href={`${base}search/`}>Search</a>
          <a href={`${base}about/`}>About</a>
          <a href={siteConfig.author.url} target="_blank" rel="noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <small>© {new Date().getFullYear()} {siteConfig.name}. Built with Astro.</small>
        <nav aria-label="Footer navigation">
          <a href={`${base}privacy/`}>Privacy</a>
          <a href={`${base}contact/`}>Contact</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
